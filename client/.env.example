# LocalFix Frontend Client Environment Variables
# Copy to client/.env and replace placeholders with production service URLs

# Backend API endpoint URL (include /api suffix)
# Local: /api (proxied by Vite)
# Production: https://your-backend.onrender.com/api
VITE_API_URL=

# Backend Socket.IO URL (domain root without /api)
# Local: http://localhost:5000
# Production: https://your-backend.onrender.com
VITE_SOCKET_URL=

# Backend Server Root URL (for resolving uploaded images /uploads)
# Local: http://localhost:5000
# Production: https://your-backend.onrender.com
VITE_SERVER_URL=
