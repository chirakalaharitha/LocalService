# LocalFix Environment Variables Template
# Copy this file to .env and configure real values for your environment.
# DO NOT commit real credentials or secrets to version control.

# Server Environment Configuration
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database Connection (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/localfix?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret
# Generate a strong 64-character random string (e.g. using `openssl rand -hex 32`)
JWT_SECRET=

# Cross-Origin Resource Sharing (CORS) URLs
# Comma-separated list of allowed frontend origins (no trailing slashes)
CLIENT_URL=https://your-frontend.vercel.app

# Server Public Base URL
SERVER_URL=https://your-backend.onrender.com

# Nodemailer / SMTP Email Configuration (Optional - falls back to mock logging if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LocalFix Support <noreply@localfix.org>
